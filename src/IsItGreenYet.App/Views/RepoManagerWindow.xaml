<Window
    x:Class="IsItGreenYet.App.Views.RepoManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:IsItGreenYet.App.Localization"
    xmlns:views="clr-namespace:IsItGreenYet.App.Views"
    xmlns:vm="clr-namespace:IsItGreenYet.App.ViewModels"
    Title="{l:T CommonRepoManager}"
    Icon="../Assets/app.ico"
    PreviewKeyDown="OnWindowPreviewKeyDown"
    ShowInTaskbar="False"
    Style="{StaticResource Style.Window.Dialog.Resizable}"
    WindowStartupLocation="CenterOwner">
    <!--  repo 管理頁（spec §11.1）：所有看得到的 repo（清單 A＋B）、類別、狀態、原因、靜音與強制納入  -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  每一列最寬是清單的可見寬度（RepoManagerWindow.RowMaxWidth 的說明）  -->
        <Style
            x:Key="Style.ListBoxItem.Repo"
            BasedOn="{StaticResource Style.ListBoxItem.Record}"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="MaxWidth" Value="{Binding RowMaxWidth, RelativeSource={RelativeSource AncestorType={x:Type views:RepoManagerWindow}}}" />
        </Style>

        <!--  略過的 repo 名稱改用 Text.Muted（spec §16.2：略過用 Text Muted）  -->
        <Style
            x:Key="Style.Text.RepoName"
            BasedOn="{StaticResource Style.Text.Body}"
            TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMonitored}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            一列：
            左邊 repo 名稱（過長截斷，tooltip 全名），下面一行是原因（略過的原因，或監看中的問題標示），沒有就不佔位
            右邊 [類別][狀態][靜音][強制納入]，上下置中；四欄用 SharedSizeGroup 讓每一列對齊
            窄版（RepoManagerWindow.CompactRows）：名稱與原因佔滿整列，四欄換到第三行、靠右，欄寬與對齊不變
        -->
        <DataTemplate x:Key="Template.RepoRow" DataType="{x:Type vm:RepoRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoCategory" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoStatus" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoMute" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoForce" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="NameText"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.Text.RepoName}"
                    Text="{Binding FullName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding FullName}" />

                <TextBlock
                    x:Name="ReasonText"
                    Grid.Row="1"
                    Margin="{StaticResource Margin.Row.Meta}"
                    Style="{StaticResource Style.Text.Caption}"
                    Text="{Binding ReasonText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />

                <Border
                    x:Name="CategoryBadge"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Margin="{StaticResource Margin.Gap.Left}"
                    Style="{StaticResource Style.Border.Badge}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource Style.Text.Badge}"
                        Text="{Binding CategoryText}" />
                </Border>

                <Border
                    x:Name="StatusBadge"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Margin="{StaticResource Margin.Gap.Left}"
                    Style="{StaticResource Style.Border.Badge}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource Style.Text.Badge}"
                        Text="{Binding StatusText}" />
                </Border>

                <!--
                    按鈕內容用 TextBlock，不直接放字串：Content 是字串時，按鈕的報讀名稱會再去掉一次快速鍵標記，
                    repo 名稱裡的第一個底線就被吃掉（2026-10-26 實測：xxx_F5 變成 xxxF5）。
                -->
                <Button
                    x:Name="MuteButton"
                    Grid.RowSpan="2"
                    Grid.Column="3"
                    Margin="{StaticResource Margin.Gap.Left}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding MuteAutomationName}"
                    Click="OnMuteClick"
                    Style="{StaticResource Style.Button.Chip}">
                    <TextBlock Text="{Binding MuteButtonText}" />
                </Button>

                <!--  不能強制納入時按鈕停用，用 tooltip 說明原因（spec §11.1）；停用的按鈕預設不顯示 tooltip  -->
                <Button
                    x:Name="ForceButton"
                    Grid.RowSpan="2"
                    Grid.Column="4"
                    Margin="{StaticResource Margin.Gap.Left}"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding ForceTooltip}"
                    AutomationProperties.Name="{Binding ForceAutomationName}"
                    Click="OnForceClick"
                    IsEnabled="{Binding CanToggleForce}"
                    Style="{StaticResource Style.Button.Chip}"
                    ToolTip="{Binding ForceTooltip}"
                    ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="{Binding ForceButtonText}" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CompactRows, RelativeSource={RelativeSource AncestorType={x:Type views:RepoManagerWindow}}}" Value="True">
                    <Setter TargetName="NameText" Property="Grid.ColumnSpan" Value="5" />
                    <Setter TargetName="ReasonText" Property="Grid.ColumnSpan" Value="5" />
                    <Setter TargetName="CategoryBadge" Property="Grid.Row" Value="2" />
                    <Setter TargetName="CategoryBadge" Property="Grid.RowSpan" Value="1" />
                    <Setter TargetName="CategoryBadge" Property="Margin" Value="{StaticResource Margin.RepoRow.Compact}" />
                    <Setter TargetName="StatusBadge" Property="Grid.Row" Value="2" />
                    <Setter TargetName="StatusBadge" Property="Grid.RowSpan" Value="1" />
                    <Setter TargetName="StatusBadge" Property="Margin" Value="{StaticResource Margin.RepoRow.Compact}" />
                    <Setter TargetName="MuteButton" Property="Grid.Row" Value="2" />
                    <Setter TargetName="MuteButton" Property="Grid.RowSpan" Value="1" />
                    <Setter TargetName="MuteButton" Property="Margin" Value="{StaticResource Margin.RepoRow.Compact}" />
                    <Setter TargetName="ForceButton" Property="Grid.Row" Value="2" />
                    <Setter TargetName="ForceButton" Property="Grid.RowSpan" Value="1" />
                    <Setter TargetName="ForceButton" Property="Margin" Value="{StaticResource Margin.RepoRow.Compact}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  標題列：整條可拖曳，✕ 關閉  -->
        <Grid
            Grid.Row="0"
            Height="{StaticResource Size.Window.DragRegionHeight}"
            Margin="{StaticResource Margin.TitleBar}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Style.Text.Body}"
                Text="{l:T CommonRepoManager}" />
            <Button
                HorizontalAlignment="Right"
                AutomationProperties.Name="{l:T CommonClose}"
                Click="OnCloseClick"
                Style="{StaticResource Style.Button.Icon}"
                ToolTip="{l:T CommonClose}">
                <Path Data="{StaticResource Geometry.Close}" Style="{StaticResource Style.Path.Icon}" />
            </Button>
        </Grid>

        <!--  頂端：文字搜尋、只看略過、數量（spec §11.1）  -->
        <Grid Grid.Row="1" Margin="{StaticResource Margin.Section}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <TextBox
                    x:Name="SearchBox"
                    Width="{StaticResource Size.Search.Width}"
                    Height="{StaticResource Size.Button.Chip.MinHeight}"
                    Padding="{StaticResource Padding.Search}"
                    AutomationProperties.Name="{l:T CommonSearch}"
                    Style="{StaticResource Style.TextBox.Input}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="{StaticResource Margin.Search.Placeholder}"
                    Style="{StaticResource Style.Text.Placeholder}"
                    Text="{l:T CommonSearchPlaceholder}"
                    Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <CheckBox
                x:Name="SkippedOnlyBox"
                Grid.Column="1"
                Margin="{StaticResource Margin.Gap.Left}"
                VerticalAlignment="Center"
                Content="{l:T ReposSkippedOnly}"
                IsChecked="{Binding SkippedOnly}"
                Style="{StaticResource Style.CheckBox}" />

            <TextBlock
                x:Name="CountText"
                Grid.Column="2"
                Margin="{StaticResource Margin.Gap.Left}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource Style.Text.Caption}"
                Text="{Binding CountText}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding CountText}" />
        </Grid>

        <!--
            Tab 依序經過每一列與它的「靜音」「強制納入」（只用鍵盤也能操作）。ListBox 預設是 Once：
            Tab 進清單後只停一個地方，其他列與「強制納入」都到不了。上下鍵照常在列之間移動。
        -->
        <Grid
            Grid.Row="2"
            Margin="{StaticResource Margin.Section.Last}"
            Grid.IsSharedSizeScope="True">
            <!--
                撐欄寬用、看不見的一列：每一欄放進目前語言所有可能的標籤，四欄一律容得下最寬的那一個。
                清單是虛擬化的，SharedSizeGroup 只算畫出來的列；沒有這一列時欄寬跟著畫出了哪幾列變（捲動時會跳），
                窄版的判斷也會跟著變。有了它，欄寬只跟語言有關。
                Visibility 是 Hidden（照常量寬度、不畫、不能點，報讀樹只在原始檢視出現），高度 0、疊在清單上方，不佔位。
                第 0 欄的空 Border 只用來接寬度變化（視窗寬度或語言變了），重新判斷窄版（RepoManagerWindow.CompactRows）。
            -->
            <Grid
                x:Name="ColumnSizer"
                Height="0"
                VerticalAlignment="Top"
                Visibility="Hidden">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoCategory" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoStatus" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoMute" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RepoForce" />
                </Grid.ColumnDefinitions>
                <Border SizeChanged="OnSizerSizeChanged" />
                <Border Grid.Column="1" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposCategoryOwn}" />
                </Border>
                <Border Grid.Column="1" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposCategoryOrganization}" />
                </Border>
                <Border Grid.Column="1" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposCategoryCollaborator}" />
                </Border>
                <Border Grid.Column="1" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposCategoryFork}" />
                </Border>
                <Border Grid.Column="2" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposMonitored}" />
                </Border>
                <Border Grid.Column="2" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposSkipped}" />
                </Border>
                <!--  按鈕欄用小標量：Style.Button.Chip 與 Style.Border.Badge 的內距、框線、字級與字重相同，一樣寬  -->
                <Border Grid.Column="3" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposMute}" />
                </Border>
                <Border Grid.Column="3" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposUnmute}" />
                </Border>
                <Border Grid.Column="4" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposForce}" />
                </Border>
                <Border Grid.Column="4" Margin="{StaticResource Margin.Gap.Left}" Style="{StaticResource Style.Border.Badge}">
                    <TextBlock Style="{StaticResource Style.Text.Badge}" Text="{l:T ReposUnforce}" />
                </Border>
            </Grid>

            <ListBox
                x:Name="RepoList"
                AutomationProperties.Name="{l:T ReposList}"
                ItemContainerStyle="{StaticResource Style.ListBoxItem.Repo}"
                ItemTemplate="{StaticResource Template.RepoRow}"
                ItemsSource="{Binding Rows}"
                KeyboardNavigation.TabNavigation="Continue"
                ScrollViewer.ScrollChanged="OnRepoListScrollChanged"
                SelectionMode="Single"
                Style="{StaticResource Style.ListBox.Records}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Resources>
                    <!--  同主畫面：用主題的細捲軸  -->
                    <Style BasedOn="{StaticResource Style.ScrollBar.Thin}" TargetType="{x:Type ScrollBar}" />
                </ListBox.Resources>
            </ListBox>

            <TextBlock
                x:Name="EmptyText"
                Margin="{StaticResource Margin.EmptyState}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource Style.Text.Caption}"
                Text="{Binding EmptyText}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{Binding HasEmptyState, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>
