<Window
    x:Class="IsItGreenYet.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:IsItGreenYet.App.Localization"
    Title="{l:T CommonSettings}"
    Icon="../Assets/app.ico"
    PreviewKeyDown="OnWindowPreviewKeyDown"
    ShowInTaskbar="False"
    Style="{StaticResource Style.Window.Dialog.Resizable}"
    WindowStartupLocation="CenterOwner">
    <!--
        設定頁（spec §11.2）：帳號、監看範圍、通知、失敗 log、寫入操作（第二階段 spec §9.5）、一般、資料；另加「語言／Language」，spec 沒有；最下方是專案連結、版本與授權聲明的入口。
        按「儲存」才生效，「取消」、✕ 或 Esc 保持原樣（同 SAM）；換語言也是按「儲存」後整個 App 即時換成新的語言。
        標籤含底線（GH_TOKEN）的核取方塊用 TextBlock 當內容：Style.CheckBox 會把字串裡的第一個底線當成快速鍵吃掉。
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  標題列：整條可拖曳，✕ 等於取消  -->
        <Grid
            Grid.Row="0"
            Height="{StaticResource Size.Window.DragRegionHeight}"
            Margin="{StaticResource Margin.TitleBar}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Style.Text.Body}"
                Text="{l:T CommonSettings}" />
            <Button
                HorizontalAlignment="Right"
                AutomationProperties.Name="{l:T CommonClose}"
                Click="OnCancelClick"
                Style="{StaticResource Style.Button.Icon}"
                ToolTip="{l:T CommonClose}">
                <Path Data="{StaticResource Geometry.Close}" Style="{StaticResource Style.Path.Icon}" />
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="{StaticResource Margin.Section}"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <!--  同 SAM：用主題的細捲軸  -->
                <Style BasedOn="{StaticResource Style.ScrollBar.Thin}" TargetType="{x:Type ScrollBar}" />
            </ScrollViewer.Resources>
            <!--  驗證 PAT 期間停用內容（捲軸照常可用）：儲存用的是按下「儲存」那一刻的值  -->
            <StackPanel IsEnabled="{Binding CanEdit}">

                <!--  帳號  -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsAccount}" />

                        <TextBlock
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{l:T SettingsAuthMethod}" />
                        <StackPanel Margin="{StaticResource Margin.Gap.Top}" Orientation="Horizontal">
                            <RadioButton
                                x:Name="GhCliRadio"
                                Margin="{StaticResource Margin.Gap.Right}"
                                Checked="OnGhCliChecked"
                                Content="gh CLI"
                                GroupName="AuthMode"
                                IsChecked="{Binding IsGhCliMode}"
                                Style="{StaticResource Style.RadioButton}" />
                            <RadioButton
                                x:Name="PatRadio"
                                Margin="{StaticResource Margin.Gap.Left}"
                                Content="PAT"
                                GroupName="AuthMode"
                                IsChecked="{Binding IsPatMode}"
                                Style="{StaticResource Style.RadioButton}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="AccountText"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Style="{StaticResource Style.Text.Body}"
                            TextWrapping="Wrap"><Run Text="{l:T SettingsSignedInAs}" /><Run Text="{Binding AccountText, Mode=OneWay}" /></TextBlock>
                        <TextBlock
                            x:Name="TokenSourceText"
                            Margin="{StaticResource Margin.Gap.Top}"
                            Style="{StaticResource Style.Text.Body}"
                            TextWrapping="Wrap"><Run Text="{l:T SettingsTokenSource}" /><Run Text="{Binding TokenSourceText, Mode=OneWay}" /></TextBlock>

                        <Button
                            x:Name="CheckConnectionButton"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            HorizontalAlignment="Left"
                            Click="OnCheckConnectionClick"
                            Content="{l:T SettingsCheckConnection}"
                            IsEnabled="{Binding CanCheckConnection}"
                            Style="{StaticResource Style.Button.Secondary}" />
                        <TextBlock
                            x:Name="ConnectionText"
                            Margin="{StaticResource Margin.Gap.Top}"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{Binding ConnectionText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasConnectionText, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            x:Name="ScopesText"
                            Margin="{StaticResource Margin.Gap.Top}"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{Binding ScopesText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasScopesText, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{l:T SettingsPat}" />
                        <Grid Margin="{StaticResource Margin.Gap.Top}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox
                                x:Name="PatBox"
                                AutomationProperties.Name="{l:T SettingsPat}"
                                IsEnabled="{Binding IsPatMode}"
                                PasswordChanged="OnPatChanged"
                                Style="{StaticResource Style.PasswordBox}" />
                            <Button
                                x:Name="ClearPatButton"
                                Grid.Column="1"
                                Margin="{StaticResource Margin.Gap.Left}"
                                Click="OnClearPatClick"
                                Content="{l:T SettingsClear}"
                                Style="{StaticResource Style.Button.Secondary}" />
                        </Grid>
                        <TextBlock
                            x:Name="PatHint"
                            Margin="{StaticResource Margin.Gap.Top}"
                            Style="{StaticResource Style.Text.Muted}"
                            Text="{Binding PatHint}"
                            TextWrapping="Wrap" />

                        <CheckBox
                            x:Name="IgnoreEnvBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            AutomationProperties.Name="{l:T SettingsIgnoreEnv}"
                            IsChecked="{Binding IgnoreGhTokenEnv}"
                            Style="{StaticResource Style.CheckBox}">
                            <TextBlock Text="{l:T SettingsIgnoreEnv}" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!--  監看範圍  -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsScope}" />
                        <CheckBox
                            x:Name="IncludeForksBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsIncludeForks}"
                            IsChecked="{Binding IncludeForks}"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="IncludeCollaboratorsBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsIncludeCollaborators}"
                            IsChecked="{Binding IncludeCollaboratorRepos}"
                            Style="{StaticResource Style.CheckBox}" />
                    </StackPanel>
                </Border>

                <!--  通知（spec §9.1 的 N1、N2、N3 與停留秒數）  -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsNotifications}" />
                        <CheckBox
                            x:Name="NotifyFailureBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsNotifyFailure}"
                            IsChecked="{Binding NotifyTrackedFailure}"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="NotifySuccessBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsNotifySuccess}"
                            IsChecked="{Binding NotifyMyRunSuccess}"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="NotifyWatchedBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsNotifyWatched}"
                            IsChecked="{Binding NotifyWatchedRunDone}"
                            Style="{StaticResource Style.CheckBox}" />

                        <TextBlock
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{Binding FailureToastLabel}" />
                        <TextBox
                            x:Name="FailureSecondsBox"
                            Width="{StaticResource Size.NumberBox.Width}"
                            Margin="{StaticResource Margin.Gap.Top}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding FailureToastLabel}"
                            Style="{StaticResource Style.TextBox.Input}"
                            Text="{Binding FailureToastSecondsText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{Binding SuccessToastLabel}" />
                        <TextBox
                            x:Name="SuccessSecondsBox"
                            Width="{StaticResource Size.NumberBox.Width}"
                            Margin="{StaticResource Margin.Gap.Top}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding SuccessToastLabel}"
                            Style="{StaticResource Style.TextBox.Input}"
                            Text="{Binding SuccessToastSecondsText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!--  失敗 log  -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsFailedLog}" />
                        <TextBlock
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{Binding LogTailLinesLabel}" />
                        <TextBox
                            x:Name="LogLinesBox"
                            Width="{StaticResource Size.NumberBox.Width}"
                            Margin="{StaticResource Margin.Gap.Top}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding LogTailLinesLabel}"
                            Style="{StaticResource Style.TextBox.Input}"
                            Text="{Binding LogTailLinesText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!--  寫入操作（第二階段 spec §9.5）：預設關閉；儲存後經 SettingsChanged 交給 Engine，run 選單看快照的 WritesEnabled  -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsWrite}" />
                        <CheckBox
                            x:Name="AllowWriteActionsBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsAllowWriteActions}"
                            IsChecked="{Binding AllowWriteActions}"
                            Style="{StaticResource Style.CheckBox}" />
                        <TextBlock
                            Margin="{StaticResource Margin.Gap.Top}"
                            Style="{StaticResource Style.Text.Muted}"
                            Text="{l:T SettingsAllowWriteActionsHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  一般  -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsGeneral}" />
                        <CheckBox
                            x:Name="RunAtStartupBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsRunAtStartup}"
                            IsChecked="{Binding RunAtStartup}"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="MinimizeToTrayBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsMinimizeToTray}"
                            IsChecked="{Binding MinimizeToTray}"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="AlwaysOnTopBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{l:T SettingsAlwaysOnTop}"
                            IsChecked="{Binding AlwaysOnTop}"
                            Style="{StaticResource Style.CheckBox}" />
                        <CheckBox
                            x:Name="CheckForUpdatesBox"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Content="{Binding CheckForUpdatesLabel}"
                            IsChecked="{Binding CheckForUpdates}"
                            Style="{StaticResource Style.CheckBox}" />
                    </StackPanel>
                </Border>

                <!--
                    語言：兩個選項一律用自己的語言顯示（English、繁體中文），標題附上另一種語言，切錯語言時也找得到。
                    按「儲存」才生效，之後整個 App（主畫面、系統匣、之後的提示與 Engine 產生的文字）即時換成新的語言。
                -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsLanguage}" />
                        <StackPanel Margin="{StaticResource Margin.Gap.Top.Large}" Orientation="Horizontal">
                            <RadioButton
                                x:Name="EnglishRadio"
                                Margin="{StaticResource Margin.Gap.Right}"
                                Content="{l:T SettingsLanguageEnglish}"
                                GroupName="Language"
                                IsChecked="{Binding IsEnglish}"
                                Style="{StaticResource Style.RadioButton}" />
                            <RadioButton
                                x:Name="TraditionalChineseRadio"
                                Margin="{StaticResource Margin.Gap.Left}"
                                Content="{l:T SettingsLanguageTraditionalChinese}"
                                GroupName="Language"
                                IsChecked="{Binding IsTraditionalChinese}"
                                Style="{StaticResource Style.RadioButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  資料  -->
                <Border Margin="{StaticResource Margin.Card.Stack}" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Style.Text.Muted}" Text="{l:T SettingsData}" />
                        <TextBlock
                            x:Name="DataPathText"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            Style="{StaticResource Style.Text.Caption}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="OpenFolderButton"
                            Margin="{StaticResource Margin.Gap.Top.Large}"
                            HorizontalAlignment="Left"
                            Click="OnOpenFolderClick"
                            Content="{l:T CommonOpenFolder}"
                            Style="{StaticResource Style.Button.Secondary}" />
                    </StackPanel>
                </Border>

                <!--
                    最下方兩列：第一列是專案連結，第二列是目前版本與「授權與第三方聲明」的入口。排成一列時，英文介面在最小寬度會換行。
                    只有文字連結，不放 GitHub 圖示（2026-11-05 作者的決定，見 docs/spec-deviations.md）；連結文字是完整網址，不暗示 GitHub 背書。
                    Style.Hyperlink.Repo 把焦點框設成 null（主畫面清單要這樣），所以這裡蓋回看得見的焦點框。
                    焦點框比文字左右各寬 4（Margin.FocusVisual.Link），捲動區會裁掉超出左邊界的部分，所以連結留 Margin.Gap.Left；版本留一樣的間距才和第一列對齊。
                -->
                <StackPanel Margin="{StaticResource Margin.Card.Stack}">
                    <TextBlock
                        x:Name="ProjectLinkText"
                        Margin="{StaticResource Margin.Gap.Left}"
                        Style="{StaticResource Style.Text.Caption}"><Hyperlink Click="OnProjectLinkClick" FocusVisualStyle="{StaticResource Style.FocusVisual.Link}" Style="{StaticResource Style.Hyperlink.Repo}"><Run Text="{Binding ProjectRepoText, Mode=OneWay}" /></Hyperlink></TextBlock>
                    <WrapPanel Margin="{StaticResource Margin.Gap.Top}" Orientation="Horizontal">
                        <TextBlock
                            x:Name="VersionText"
                            Margin="{StaticResource Margin.Gap.Left}"
                            VerticalAlignment="Center"
                            Style="{StaticResource Style.Text.Caption}"
                            Text="{Binding VersionLabel}" />
                        <TextBlock
                            x:Name="NoticesLinkText"
                            Margin="{StaticResource Margin.Gap.Left}"
                            VerticalAlignment="Center"
                            Style="{StaticResource Style.Text.Caption}"><Hyperlink Click="OnNoticesClick" FocusVisualStyle="{StaticResource Style.FocusVisual.Link}" Style="{StaticResource Style.Hyperlink.Repo}"><Run Text="{l:T SettingsNotices}" /></Hyperlink></TextBlock>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  底部：錯誤或進度說明、取消、儲存  -->
        <Grid Grid.Row="2" Margin="{StaticResource Margin.Section.Last}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{StaticResource Brush.Danger}"
                    Style="{StaticResource Style.Text.Caption}"
                    Text="{Binding ErrorText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    x:Name="StatusText"
                    Style="{StaticResource Style.Text.Caption}"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Margin="{StaticResource Margin.Gap.Left}"
                Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    Margin="{StaticResource Margin.Gap.Right}"
                    Click="OnCancelClick"
                    Content="{l:T CommonCancel}"
                    Style="{StaticResource Style.Button.Secondary}" />
                <Button
                    x:Name="SaveButton"
                    Click="OnSaveClick"
                    Content="{l:T CommonSave}"
                    IsDefault="True"
                    IsEnabled="{Binding CanSave}"
                    Style="{StaticResource Style.Button.Accent}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
