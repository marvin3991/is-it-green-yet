<Window
    x:Class="IsItGreenYet.App.Views.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interop="clr-namespace:IsItGreenYet.App.Interop"
    Title="IsItGreenYet"
    Width="{StaticResource Size.Dialog.Width}"
    interop:DwmFrame.Corner="Round"
    AllowsTransparency="False"
    Background="{StaticResource Brush.Surface}"
    BorderBrush="{StaticResource Brush.Border}"
    BorderThickness="{StaticResource Thickness.Border.Standard}"
    FocusManager.FocusedElement="{Binding ElementName=NoButton}"
    FontFamily="{StaticResource FontFamily.Default}"
    Icon="../Assets/app.ico"
    PreviewKeyDown="OnPreviewKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <!--
        寫入的確認對話框（第二階段 spec §9.2）：外框同錯誤對話框（ErrorDialog.xaml），不放錯誤圖示、不播音效。
        內容區是標題與可以選取複製的訊息（是哪一筆 run，空一行後是說明的重點）；按鈕列另一層。
        左「不要」：IsCancel（Esc 與點按都關閉、不執行），開啟時焦點在它上面。
        右邊的執行按鈕不設 IsDefault：焦點在「不要」時按 Enter 是「不要」，不會誤觸執行。樣式依取消類（Danger）或重跑類（Accent）由程式設定。
        訊息的鍵盤捲動與 Ctrl+C 同錯誤對話框（DialogMessageKeys）；沒有標題列，在空白處按住可以拖曳。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource Padding.Dialog}">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource Style.Text.Title}"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="MessageText"
                MaxHeight="{StaticResource Size.Dialog.MessageMaxHeight}"
                Margin="{StaticResource Margin.Gap.Top.Large}"
                Style="{StaticResource Style.TextBox.Message}" />
        </StackPanel>

        <!--  按鈕列：兩顆平分寬度（同 Windows 11 對話框），中間隔 Margin.Gap 的兩倍  -->
        <Border
            Grid.Row="1"
            Padding="{StaticResource Padding.Dialog}"
            Background="{StaticResource Brush.Window.Background}"
            BorderBrush="{StaticResource Brush.Surface.Hover}"
            BorderThickness="{StaticResource Thickness.Border.Top}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="NoButton"
                    Margin="{StaticResource Margin.Gap.Right}"
                    IsCancel="True"
                    Style="{StaticResource Style.Button.Secondary}" />
                <Button
                    x:Name="ConfirmButton"
                    Grid.Column="1"
                    Margin="{StaticResource Margin.Gap.Left}"
                    Click="OnConfirmClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
