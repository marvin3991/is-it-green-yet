<Window
    x:Class="IsItGreenYet.App.Views.NoticesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:IsItGreenYet.App.Localization"
    Title="{l:T SettingsNotices}"
    FocusManager.FocusedElement="{Binding ElementName=CloseButton}"
    Icon="../Assets/app.ico"
    PreviewKeyDown="OnPreviewKeyDown"
    ShowInTaskbar="False"
    Style="{StaticResource Style.Window.Dialog.Resizable}"
    WindowStartupLocation="CenterOwner">
    <!--
        授權與第三方聲明（設定頁最下方的入口）：顯示內嵌的 LICENSE 與 THIRD-PARTY-NOTICES.md 全文（Core 的 EmbeddedNotices），不翻譯。
        外框同設定頁與 repo 管理頁：可以縮放，標題列可以拖曳，✕ 關閉。內文可以選取複製；焦點不論在哪裡都能用 ↑↓、PageUp／PageDown、Home／End 捲動，
        Ctrl+C 複製標題加全文（DialogMessageKeys）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  標題列：整條可拖曳  -->
        <Grid
            Grid.Row="0"
            Height="{StaticResource Size.Window.DragRegionHeight}"
            Margin="{StaticResource Margin.TitleBar}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Style.Text.Body}"
                Text="{l:T SettingsNotices}" />
            <Button
                HorizontalAlignment="Right"
                AutomationProperties.Name="{l:T CommonClose}"
                Click="OnCloseClick"
                Style="{StaticResource Style.Button.Icon}"
                ToolTip="{l:T CommonClose}">
                <Path Data="{StaticResource Geometry.Close}" Style="{StaticResource Style.Path.Icon}" />
            </Button>
        </Grid>

        <TextBox
            x:Name="MessageText"
            Grid.Row="1"
            Margin="{StaticResource Margin.Section}"
            AutomationProperties.Name="{l:T SettingsNoticesFullText}"
            FontSize="{StaticResource FontSize.Caption}"
            Style="{StaticResource Style.TextBox.Message}" />

        <!--  同錯誤對話框：IsDefault＋IsCancel，Enter、Esc、點按都走 IsCancel 的關閉對話框，不另外掛 Click；✕ 不設 IsCancel，兩顆都設時 Esc 不會按下任何一顆  -->
        <Button
            x:Name="CloseButton"
            Grid.Row="2"
            Margin="{StaticResource Margin.Section.Last}"
            HorizontalAlignment="Right"
            Content="{l:T CommonClose}"
            IsCancel="True"
            IsDefault="True"
            Style="{StaticResource Style.Button.Accent}" />
    </Grid>
</Window>
