<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Directory.Build.props 的 RuntimeIdentifiers 只是為了 lock 檔。沒有這行，發行時 Core 會跟著 -r win-x64 建成 x64 專用，和 AnyCPU 時的 dll 不同。 -->
    <IsRidAgnostic>true</IsRidAgnostic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 授權與第三方聲明跟著 exe 走（EmbeddedNotices 讀）：App、CLI 都參考 Core，放這裡只有一份；LogicalName 固定，不受資料夾影響 -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="IsItGreenYet.Core.Legal.LICENSE" Link="Legal\LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="IsItGreenYet.Core.Legal.THIRD-PARTY-NOTICES.md" Link="Legal\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- 讓測試專案能直接驗證 internal 的解析與格式化邏輯 -->
    <InternalsVisibleTo Include="IsItGreenYet.Core.Tests" />
  </ItemGroup>

</Project>
